// ============================================================
// Testbench — terminal output
// Tests all 2048 combinations against a golden model.
// ============================================================

module alu_mid_tb;

    reg  [3:0] a, b;
    reg  [2:0] opcode;
    wire [3:0] result;
    wire carry_out, zero, overflow;

    reg  [3:0] exp_result;
    reg  exp_carry, exp_zero, exp_overflow;
    reg  [4:0] temp;

    integer i, j, k;
    integer errors, total;

    alu dut (
        .a(a), .b(b), .opcode(opcode),
        .result(result), .carry_out(carry_out),
        .zero(zero), .overflow(overflow)
    );

    initial begin
        errors = 0;
        total  = 0;

        for (i = 0; i < 16; i = i + 1) begin
            for (j = 0; j < 16; j = j + 1) begin
                for (k = 0; k < 8; k = k + 1) begin

                    a      = i[3:0];
                    b      = j[3:0];
                    opcode = k[2:0];
                    #1;
                    total = total + 1;

                    exp_carry    = 1'b0;
                    exp_overflow = 1'b0;

                    case (opcode)
                        3'b000: begin
                            temp         = {1'b0, a} + {1'b0, b};
                            exp_result   = temp[3:0];
                            exp_carry    = temp[4];
                            exp_overflow = (a[3] == b[3]) && (exp_result[3] != a[3]);
                        end
                        3'b001: begin
                            temp         = {1'b0, a} - {1'b0, b};
                            exp_result   = temp[3:0];
                            exp_carry    = temp[4];
                            exp_overflow = (a[3] != b[3]) && (exp_result[3] != a[3]);
                        end
                        3'b010: exp_result = a & b;
                        3'b011: exp_result = a | b;
                        3'b100: exp_result = a ^ b;
                        3'b101: exp_result = ~a;
                        3'b110: begin
                            exp_result = a << 1;
                            exp_carry  = a[3];
                        end
                        3'b111: begin
                            exp_result = a >> 1;
                            exp_carry  = a[0];
                        end
                        default: exp_result = 4'b0000;
                    endcase

                    exp_zero = (exp_result == 4'b0000);

                    if (result !== exp_result || carry_out !== exp_carry ||
                        zero !== exp_zero || overflow !== exp_overflow) begin
                        errors = errors + 1;
                        $display("FAIL a=%0d b=%0d op=%b | got r=%0d c=%b z=%b ov=%b | exp r=%0d c=%b z=%b ov=%b",
                            a, b, opcode, result, carry_out, zero, overflow,
                            exp_result, exp_carry, exp_zero, exp_overflow);
                    end

                end
            end
        end

        $display("------------------------------------------------");
        if (errors == 0)
            $display("ALL %0d TESTS PASSED", total);
        else
            $display("%0d FAILURES out of %0d", errors, total);
        $display("------------------------------------------------");

        $finish;
    end

endmodule
